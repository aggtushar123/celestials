# Copy this file to .env and adjust as needed. .env is gitignored.

# Django
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://revenact:revenact@localhost:5432/revenact

# Redis — the channel layer backing Multiplayer Copilot's real-time push
# (see services/copilot/consumers.py). Matches docker-compose.yml's own
# `redis` service; run it standalone for local dev with
# `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379/0

# CORS — origins the frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (forgot/reset password) — leave both blank to fall back to the
# console backend (reset emails print to this terminal instead of sending).
# For Gmail SMTP: enable 2FA on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and use that here, NOT your
# normal Gmail password. With DEBUG off and no credentials, survey sends are
# refused (400) rather than printing their live links.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# Seconds before a silent SMTP server gives up (the minute sender must not hang)
# EMAIL_TIMEOUT=30
# DEFAULT_FROM_EMAIL=

# Frontend origin the emailed reset link points at
FRONTEND_URL=http://localhost:5173

# Copilot — leave everything below blank to have Copilot respond with a
# clear "not configured" error instead of a fake answer.
#
# COPILOT_LLM_PROVIDER picks which real backend actually gets called —
# "anthropic" (default, Anthropic's own API directly, needs
# ANTHROPIC_API_KEY — get one at https://console.anthropic.com/) or
# "bedrock" (the identical Claude model through AWS Bedrock instead,
# needs real AWS credentials + BEDROCK_MODEL_ID below — that model must
# already have real Bedrock model access approved for it in your own AWS
# account/region first, a one-time step in the AWS Console).
COPILOT_LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Only used when COPILOT_LLM_PROVIDER=bedrock. BEDROCK_MODEL_ID is a real
# Bedrock model id from your own console (a different id format than
# ANTHROPIC_MODEL above) — e.g. anthropic.claude-3-5-sonnet-20240620-v1:0.
# Real gotcha, hit and fixed live: in some regions the plain model id
# above gets rejected with "on-demand throughput isn't supported... use
# an inference profile" — if that happens, use the region-group-prefixed
# cross-region inference profile id instead (find it under Bedrock ->
# Cross-region inference in your own console), e.g.
# apac.anthropic.claude-3-5-sonnet-20240620-v1:0 for ap-south-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=

# Only used when COPILOT_LLM_PROVIDER=gemini: Gemini on Vertex AI, using your
# Google credentials (`gcloud auth application-default login` locally, the
# service account on Cloud Run) — no API key. Each purpose runs on a tier
# (lite / flash / pro, see GEMINI_TIERS in config/settings.py); the models,
# locations and thinking levels below are the defaults.
# GOOGLE_CLOUD_PROJECT=revenact-prod
# GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_FLASH_MODEL=gemini-3.5-flash
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# GEMINI_PRO_LOCATION=global
# GEMINI_PURPOSE_TIERS=brief=flash,account_brief=flash

# Uploaded files: set to a private Cloud Storage bucket on Cloud Run; unset
# keeps them on local disk under MEDIA_ROOT.
# GS_BUCKET_NAME=revenact-prod-media

# --- Security / observability (all optional; defaults shown) ------------------
# DEBUG=False is the default. SECRET_KEY is required when DEBUG is off — the
# app refuses to start with the dev placeholder above in production.
#
# Number of reverse-proxy hops in front of Django. 1 = the deployment's Caddy
# (client IP read from X-Forwarded-For); set 0 when nothing sits in front.
# Drives the login rate limits and the audit log's source IP.
# NUM_PROXIES=1
#
# Rate limits on the public auth endpoints (DRF format "<n>/<period>").
# THROTTLE_LOGIN=10/min
# THROTTLE_LOGIN_ACCOUNT=5/min
# THROTTLE_SIGNUP=5/hour
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_TOKEN_REFRESH=30/min
# Per-IP limit on the public survey link (GET and POST share one counter).
# THROTTLE_SURVEY_LINK=30/min
#
# Root log level. Output is JSON lines when DEBUG is off, plain text in dev.
# LOG_LEVEL=INFO

# --- Personal mailboxes (Settings › Integrations › Your mailbox) --------------
# Google: OAuth client (Web application) in Google Cloud with the Gmail API
# enabled; authorised redirect URI <API origin>/api/v1/mail/oauth/google/callback/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft: Entra app registration (web) with delegated Mail.Read, Mail.Send,
# User.Read, offline_access; redirect URI <API origin>/api/v1/mail/oauth/microsoft/callback/
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common
# Fernet key for credentials at rest (derived from SECRET_KEY when unset):
# MAIL_TOKEN_KEY=
# The API's public origin, used to build the redirect URIs above:
# MAIL_OAUTH_REDIRECT_BASE=http://localhost:8000
# Two-way Gmail. Only a workspace the platform portal has switched on may
# connect Google. Optional push: a Pub/Sub topic Gmail publishes to, and the
# push subscription's OIDC audience and service account.
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GMAIL_PUBSUB_AUDIENCE=https://<public host>/api/v1/mail/google/push/
# GMAIL_PUBSUB_SERVICE_ACCOUNT=<name>@<project>.iam.gserviceaccount.com
# Cloud Run: sync a woken mailbox inside the push request (no mail loop runs there).
# MAIL_SYNC_ON_PUSH=True
# Cloud Scheduler ticks (POST /api/v1/internal/tick/<task>/, core/ticks.py): the
# OIDC audience and the service account Scheduler signs as. Unset: every tick 401.
# TICK_AUDIENCE=https://<public host>/api/v1/internal/tick/
# TICK_SERVICE_ACCOUNT=<name>@<project>.iam.gserviceaccount.com
# MAIL_SYNC_INTERVAL_SECONDS=60
# MAIL_IMPORT_MONTHS=12
# MAIL_DISCONNECT_RETENTION_DAYS=30
# Two-way Gmail delivery 2 (the outbox and attachments); the defaults are the contract's.
# MAIL_OUTBOX_MAX_ATTEMPTS=5
# MAIL_OUTBOX_RETRY_SECONDS=30,120,600,3600
# MAIL_OUTBOX_BATCH_SIZE=1000
# MAIL_OUTBOX_SINGLE_CALLS_PER_TICK=200
# MAIL_OUTBOX_ISSUE_DAYS=7
# MAIL_OUTBOX_SENT_RETENTION_HOURS=24
# MAIL_ACTION_MAX_MESSAGES=1000
# MAIL_THREAD_MAX_MESSAGES=100
# MAIL_ATTACHMENT_MAX_BYTES=52428800
# THROTTLE_MAIL_ATTACHMENT=120/min
# MAIL_SEND_MAX_BYTES=26214400
# MAIL_SEND_MAX_RECIPIENTS=100
# MAIL_DRAFT_MAX_ATTACHMENTS=25
# MAIL_SEND_AS_REFRESH_HOURS=24
# MAIL_OUTBOX_DRAFT_CALLS_PER_TICK=50
# MAIL_SEND_TIMEOUT_SECONDS=120
# MAIL_GMAIL_SEARCH_PAGE_SIZE=20
# MAIL_DRAFT_SENT_RETENTION_DAYS=7
# THROTTLE_MAIL_GMAIL_SEARCH=30/min
# THROTTLE_MAIL_DRAFT_UPLOAD=60/min

# --- Sign in with Google or Microsoft (services.identity) ------------------
# Off by default. With it off, the OAuth endpoints answer as though the
# feature does not exist and password sign-in is unaffected.
AUTH_V2_ENABLED=False
# Reuses the OAuth client ids above (GOOGLE_OAUTH_*, MICROSOFT_OAUTH_*) and
# MAIL_OAUTH_REDIRECT_BASE, which must be this API's public origin. Register
# <base>/api/v1/auth/oauth/<provider>/callback/ as a redirect URI with each
# provider, exactly, including the trailing slash.

# --- Billing ----------------------------------------------------------------
# A new workspace starts on the trial plan: this many seats, this many AI
# credits, for this many days. One model call costs BILLING_CREDITS_PER_MODEL_CALL.
# BILLING_TRIAL_SEATS=3
# BILLING_TRIAL_CREDITS=200
# BILLING_TRIAL_DAYS=14
# BILLING_CREDITS_PER_MODEL_CALL=1
# False records seats and credits without ever refusing anything (beta mode).
# BILLING_ENFORCED=True
# Seconds a Slack or Jira call by an agent step waits.
AGENT_TOOL_TIMEOUT_SECONDS=15
# Atlassian OAuth 2.0 (3LO) app for per-person Jira links (developer.atlassian.com).
# Both empty: linking is off and every Jira step acts as the connection's account.
# Callback: <MAIL_OAUTH_REDIRECT_BASE or http://localhost:8000>/api/v1/connectors/jira-link/callback/
# ATLASSIAN_OAUTH_CLIENT_ID=
# ATLASSIAN_OAUTH_CLIENT_SECRET=
# Slack app (api.slack.com/apps) for the Slack connector's sign-in and per-person
# Slack links (user scopes chat:write,users:read only). Both empty: linking is off.
# Link callback: <MAIL_OAUTH_REDIRECT_BASE or http://localhost:8000>/api/v1/connectors/slack-link/callback/
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# The Slack app's signing secret (Basic Information › App Credentials): verifies the
# "Send to Revenact" shortcut at /api/v1/connectors/slack/interactivity/. Empty: every request 401.
# SLACK_SIGNING_SECRET=
# THROTTLE_SLACK_INTERACTIVITY=120/min
# Per source IP on Slack's Events API URL (/api/v1/connectors/slack/events/, Slack
# escalations D3): every message in every public channel arrives here, so it is roomier.
# THROTTLE_SLACK_EVENTS=1200/min
